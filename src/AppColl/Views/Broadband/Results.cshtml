@{
    ViewData["Title"] = "Results";
}

@model BroadbandRecord[]

<div class="container mt-4">
    <div class="row">
        <button type="btn" onclick="location.href='@Url.Action("clear", "broadband")'">Clear</button>
    </div>
    <div class="row">
        <div class="mb-4">
            <h1>@ViewData["Title"]</h1>
            <p class="text-muted">Here are the imported broadband records.</p>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ZIP Code</th>
                        <th>Home Broadband</th>
                        <th>Mobile Broadband</th>
                        <th>No Internet Access</th>
                        <th>Home Connection Level</th>
                        <th>Mobile Connection Level</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var record in Model)
                    {
                        <tr>
                            <td>@record.ZipCode</td>
                            <td>@record.HomeBroadbandAdoption</td>
                            <td>@record.MobileBroadbandAdoption</td>
                            <td>@record.NoInternetAccessPercentage</td>
                            <td>@record.NoHomeBroadbandAdoptionLevel</td>
                            <td>@record.NoMobileBroadbandAdoptionLevel</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>